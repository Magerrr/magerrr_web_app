# Salin ke .env.local lalu isi. Jangan commit nilai asli.
# Lokal: jalankan `npx supabase start`, lalu ambil nilai dari `npx supabase status`.

# URL publik aplikasi (dipakai untuk tautan undangan/tagihan/recap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Rahasia, hanya di server (route handler). Jangan diberi prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Analytics (opsional). Kosong = event hanya dicatat di log server saat dev.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
